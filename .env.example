# OAuth (Kakao 필수, Naver 선택)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# JWT 시크릿 (랜덤 문자열로 변경)
JWT_SECRET=change-this-to-random-string

# 서비스 URL (OAuth 콜백에 사용)
BASE_URL=https://your-domain:2290

# 여행 계획 에이전트 토큰 (Claude가 견적을 채워넣을 때 Bearer로 사용. 길고 랜덤하게)
AGENT_TOKEN=

# Web Push (VAPID 키 - npx web-push generate-vapid-keys 로 생성)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
